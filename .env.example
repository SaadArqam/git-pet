# GitHub OAuth App — create at github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret
NEXTAUTH_URL=http://localhost:3000

# GitHub PAT for OG card generation (needs read:user scope)
GITHUB_CARD_TOKEN=ghp_your_token_here

# PartyKit — your partykit host (from partykit.dev dashboard)
NEXT_PUBLIC_PARTYKIT_HOST=your-project.your-username.partykit.dev

# Upstash Redis — from upstash.com console
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here